# Google Gemini — parsing, discovery, enrichment, and research
GEMINI_API_KEY=your-gemini-api-key

# Gemini model IDs
LIGHT_LLM_MODEL=gemini-flash-latest
HEAVY_LLM_MODEL=gemini-flash-latest

# Neon PostgreSQL (required for auth, sessions, and chat history)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Session cookie signing secret
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" to re-hash demo passwords on boot
# FORCE_RESEED_DEMO_USERS=true

# Server port (default 3001)
# PORT=3001

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Set to "true" to skip live heavy search in the API
# SKIP_HEAVY_SEARCH=true

# OpenAI discovery tuning (optional)
# OPENAI_DISCOVERY_LIMIT=10
# PE_RESULT_CAP=10
# ENRICH_CONCURRENCY=4
